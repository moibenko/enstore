--
-- Name: encp_xfer_by_day_view; Type: VIEW; Schema: public; Owner: enstore
--

CREATE VIEW public.encp_xfer_by_day_view AS
 SELECT (sum(encp_xfer.size))::double precision AS date,
    encp_xfer.rw AS size,
    encp_xfer.mover AS rw,
    (substr((encp_xfer.date)::text, 0, 11))::timestamp without time zone AS mover
   FROM public.encp_xfer
  GROUP BY encp_xfer.rw, encp_xfer.mover, (substr((encp_xfer.date)::text, 0, 11));


ALTER TABLE public.encp_xfer_by_day_view OWNER TO enstore;

