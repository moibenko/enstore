--

CREATE FUNCTION public.unix2timestamp(bigint) RETURNS timestamp with time zone
    LANGUAGE plpgsql
    AS $_$
DECLARE
    STAMP  TIMESTAMP WITH TIME ZONE;
BEGIN
    select TIMESTAMP WITH TIME ZONE 'epoch' +($1) * INTERVAL '1 second' into STAMP;
    return STAMP;
END;
$_$;


