--

CREATE VIEW public.encp_xfer_by_day_view_correct AS
 SELECT (sum(encp_xfer.size))::double precision AS size,
    encp_xfer.rw,
    (substr((encp_xfer.date)::text, 0, 11))::timestamp without time zone AS date
   FROM public.encp_xfer
  GROUP BY encp_xfer.rw, (substr((encp_xfer.date)::text, 0, 11));


ALTER TABLE public.encp_xfer_by_day_view_correct OWNER TO enstore;

