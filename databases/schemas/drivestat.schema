--
-- Name: status; Type: TABLE; Schema: public; Owner: enstore
--

CREATE TABLE public.status (
    drive_sn character varying(32),
    drive_vendor character varying(32),
    product_type character varying(32),
    host character varying(32),
    logical_drive_name character varying(32),
    stat_type character varying(32),
    "time" timestamp without time zone,
    tape_volser character varying,
    power_hrs integer,
    motion_hrs integer,
    cleaning_bit integer,
    mb_user_read integer,
    mb_user_write integer,
    mb_dev_read integer,
    mb_dev_write integer,
    read_errors integer,
    write_errors integer,
    track_retries integer,
    underrun integer,
    mount_count integer,
    wp integer DEFAULT 0,
    firmware_version character varying(32),
    mover_name character varying,
    oid bigint DEFAULT nextval('public.status_oid_seq'::regclass)
);


ALTER TABLE public.status OWNER TO enstore;

--
-- Name: drive_info; Type: VIEW; Schema: public; Owner: enstore
--

CREATE VIEW public.drive_info AS
 SELECT DISTINCT ON (status.logical_drive_name) status.logical_drive_name AS drive,
    status.host,
    status.product_type AS type,
    status.drive_vendor AS vendor,
    status.drive_sn AS sn,
    status.firmware_version AS firmware
   FROM public.status
  ORDER BY status.logical_drive_name, status."time" DESC;


ALTER TABLE public.drive_info OWNER TO enstore;

