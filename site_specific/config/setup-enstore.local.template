#   {ENSTORE_HOME}/site_specific/config/setup-enstore.local
# has to be symlinked to this or similar file during system configuration.
# The file setup-enstore.local will be sourced from setup-enstore file.
# File setup-enstore.local.README provides further details.

## Uncomment the following lines and fill with values
# name of framlets. Not needed if farmlets are not used
#ENSTORE_GANG=stken

# The host name or IP address of the host where configuration server is running
#ENSTORE_CONFIG_HOST=

# The port of the configuration server
ENSTORE_CONFIG_PORT=7500

