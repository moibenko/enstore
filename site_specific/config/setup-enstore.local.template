#ENSTORE_CONFIG_FILE=${ENSTORE_CONFIG_DIR}/config/enstore-system.conf

# Define this only if Small Files Aggregation is needed and exists in configuration file
#ENSTORE_SFA_POLICY=${ENSTORE_CONFIG_DIR}/config/stken_policy.py

